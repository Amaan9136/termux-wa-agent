# ==========================================================
# termux-wa-agent configuration
# Copy this file to .env and edit values.
#   cp .env.example .env
# ==========================================================

# --- Owner / identity -------------------------------------------------
# Your WhatsApp number in international format, digits only (no +).
OWNER_NUMBER=918867305645
# JID is derived automatically as OWNER_NUMBER@s.whatsapp.net, override if needed.
OWNER_JID=918867305645@s.whatsapp.net

# Bot display name, used in help text / logs only.
BOT_NAME=AMK's AI Assistant

# --- Auth ---------------------------------------------------------------
# "qr" prints a QR code to scan. "pairing" prints a numeric pairing code
# (recommended for headless Termux use - no camera needed).
AUTH_METHOD=pairing
AUTH_DIR=./data/auth_info

# --- LLM backend ----------------------------------------------------------
# Only Ollama is wired by default (matches your existing local setup).
# The abstraction in src/services/llm.js makes it easy to swap providers.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=gpt-oss:20b-cloud
# No vision model configured - images are handled via caption-only text path.
OLLAMA_VISION_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_CHARS=1500

# --- Storage --------------------------------------------------------------
DB_PATH=./data/agent.db
MEDIA_DIR=./media

# --- Memory / context builder ---------------------------------------------
# How many most-recent raw messages to include verbatim in prompt context.
RECENT_WINDOW_SIZE=12
# Summarize older messages once a chat's unsummarized message count exceeds this.
SUMMARY_TRIGGER_COUNT=40
# Max characters kept in a chat's rolling summary before it gets compacted.
SUMMARY_MAX_CHARS=2000

# --- Group safety defaults --------------------------------------------------
# Default behavior for groups NOT explicitly configured yet.
# off = ignore group entirely, on = respond normally, mention = only on @mention/reply
DEFAULT_GROUP_MODE=off

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# --- Message queue / send throttling ----------------------------------------
SEND_MIN_INTERVAL_MS=800
SEND_MAX_RETRIES=3

# --- Failure alerts ----------------------------------------------------------
# If set, the bot DMs this JID (defaults to owner) when a fatal/reconnect-loop occurs.
ALERT_OWNER_ON_CRASH=true
